{
  "specVersion": 2,
  "id": "com.hooch88.tavo-storystate",
  "name": {
    "$t": "plugin.name"
  },
  "version": "0.2.0-dev.2",
  "minAppVersion": "0.93.0",
  "entry": "entry.js",
  "author": "Hooch88",
  "description": {
    "$t": "plugin.description"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json"
    }
  },
  "permissions": [
    "variable",
    "message",
    "generate",
    "file"
  ],
  "contributes": {
    "sidebar": [
      {
        "id": "open-storystate",
        "label": {
          "$t": "actions.openStoryState"
        }
      }
    ],
    "htmlFragments": [
      {
        "id": "storystate-panel",
        "src": "ui/panel.html",
        "mount": "/chat/body/end"
      },
      {
        "id": "storystate-tavo-1x-compat",
        "src": "ui/compat-1.2.html",
        "mount": "/chat/body/end"
      }
    ]
  }
}
