{
  "specVersion": 2,
  "id": "com.hooch88.tavo-storystate",
  "name": {
    "$t": "plugin.name"
  },
  "version": "0.8.0-dev.18",
  "minAppVersion": "0.93.0",
  "entry": "entry.js",
  "author": "Hooch88",
  "description": {
    "$t": "plugin.description"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json"
    }
  },
  "permissions": [
    "variable",
    "message",
    "generate",
    "file"
  ],
  "contributes": {
    "sidebar": [
      {
        "id": "open-storystate",
        "label": {
          "$t": "actions.openStoryState"
        }
      }
    ],
    "htmlFragments": [
      {
        "id": "storystate-panel",
        "src": "ui/panel.html",
        "mount": "/chat/body/end"
      }
    ]
  },
  "releaseNotes": "Add uploaded NPC portraits and selection from Visual Library character images in chat, current campaign and global collections. Display portraits in cards and profiles, preserve them through edits and fall back to initials."
}
