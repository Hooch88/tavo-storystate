{
  "specVersion": 2,
  "id": "com.hooch88.tavo-storystate",
  "name": {
    "$t": "plugin.name"
  },
  "version": "0.8.0-dev.21",
  "minAppVersion": "0.93.0",
  "entry": "entry.js",
  "author": "Hooch88",
  "description": {
    "$t": "plugin.description"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json"
    }
  },
  "permissions": [
    "variable",
    "message",
    "generate",
    "file"
  ],
  "contributes": {
    "sidebar": [
      {
        "id": "open-storystate",
        "label": {
          "$t": "actions.openStoryState"
        }
      }
    ],
    "htmlFragments": [
      {
        "id": "storystate-panel",
        "src": "ui/panel.html",
        "mount": "/chat/body/end"
      }
    ]
  },
  "releaseNotes": "Automatically archive resolved temporary public plans using newer quoted evidence during normal scans. Preserve manual edits, secrets and enduring facts; add Show archived knowledge, restore protection, and a Settings toggle."
}
